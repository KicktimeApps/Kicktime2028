# Kopiere diese Datei nach .env und trage deine Werte ein.
# Alternativ zu dieser Datei: Werte in src/public-config.ts eintragen.
# ALLES IST OPTIONAL – ohne Werte läuft KickTime vollständig im Browser
# (Live-Daten direkt von OpenLigaDB, Erinnerungen nur bei geöffneter App).

# Supabase (Backend für Push, Admin-Korrekturen, Statistik, Feedback)
VITE_SUPABASE_URL=https://dein-projekt.supabase.co
VITE_SUPABASE_ANON_KEY=dein-anon-key

# Web Push (öffentlicher VAPID-Schlüssel)
VITE_VAPID_PUBLIC_KEY=

# Live-Datenquelle OpenLigaDB (Standard: em / 2028)
VITE_OPENLIGA_LEAGUE=em
VITE_OPENLIGA_SEASON=2028

# Öffentliche Adresse (für Canonical-Links/Sitemap) und Impressum
VITE_SITE_URL=
VITE_LEGAL_URL=https://kicktime2026.de

# ---- Nur als Supabase-Secrets setzen (NIE ins Frontend!) ----
# ADMIN_PIN=mindestens-6-stellig
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:du@example.com
# CRON_SECRET=zufaelliger-langer-wert
# OPENLIGA_LEAGUE=em
# OPENLIGA_SEASON=2028
